<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_yarooms_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textoTituloDiretor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Painel do Diretor"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/textoNomeDiretor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olá, Diretor"
            android:textColor="@color/yarooms_gold_light"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/textoDescricaoDiretor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerencie as salas disponíveis da escola."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/botaoCadastrarSala"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Cadastrar\nsala"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold" />

            <Button
                android:id="@+id/botaoMinhasSalas"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Minhas\nsalas"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold_light" />

            <Button
                android:id="@+id/botaoAgendamentosGerais"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Agendamentos\ngerais"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold" />

            <Button
                android:id="@+id/botaoOpcoesUso"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Opções\nde uso"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold_light" />

            <Button
                android:id="@+id/botaoPeriodosAula"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="Períodos\nde aula"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold" />

        </GridLayout>

        <Button
            android:id="@+id/botaoSabadoLetivo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Sábado letivo: carregando..."
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/yarooms_blue_dark"
            android:backgroundTint="@color/yarooms_gold_light"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSairDiretor"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:text="Sair"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/yarooms_danger"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/botaoInfoApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ⓘ"
            android:textSize="26sp"
            android:textColor="@color/yarooms_gold_light"
            android:layout_gravity="center"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>