<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_yarooms_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <include layout="@layout/include_botao_voltar_topo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opções de uso"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastre o que pode ser feito em um espaço reservado."
            android:textColor="@color/yarooms_gold_light"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNomeOpcaoUso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome da opção"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/yarooms_gold"
            app:boxStrokeErrorColor="@color/yarooms_error"
            app:errorTextColor="@color/yarooms_error"
            app:hintTextColor="@color/yarooms_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNomeOpcaoUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textColorHint="@color/yarooms_gold_light"
                android:inputType="textCapSentences" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/botaoCadastrarOpcaoUso"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cadastrar opção"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/yarooms_blue_dark"
            android:backgroundTint="@color/yarooms_gold" />

        <TextView
            android:id="@+id/textoErroOpcoesUso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yarooms_error"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp" />

        <ListView
            android:id="@+id/listaOpcoesUso"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:background="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:padding="4dp"
            android:clipToPadding="false"
            android:scrollbarStyle="insideInset"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>