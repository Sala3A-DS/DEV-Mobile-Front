<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_yarooms_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <include layout="@layout/include_botao_voltar_topo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Períodos de aula"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastre os horários que poderão ser reservados."
            android:textColor="@color/yarooms_gold_light"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerar períodos automaticamente"
            android:textColor="@color/yarooms_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turno"
            android:textColor="@color/yarooms_gold"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@color/yarooms_blue_dark">

            <Spinner
                android:id="@+id/spinnerTurnoGeracao"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="0dp"
                android:paddingEnd="48dp"
                android:background="@android:color/transparent"
                android:popupBackground="@color/yarooms_blue_light" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_down"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp" />

        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutQuantidadeAulas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantidade de aulas"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/yarooms_gold"
            app:boxStrokeErrorColor="@color/yarooms_error"
            app:errorTextColor="@color/yarooms_error"
            app:hintTextColor="@color/yarooms_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editQuantidadeAulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/yarooms_gold_light" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutHorarioInicialGeracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Horário inicial"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/yarooms_gold"
            app:boxStrokeErrorColor="@color/yarooms_error"
            app:errorTextColor="@color/yarooms_error"
            app:hintTextColor="@color/yarooms_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editHorarioInicialGeracao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="Ex: 07:00"
                android:inputType="time"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/yarooms_gold_light" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDuracaoAula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Duração de cada aula em minutos"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/yarooms_gold"
            app:boxStrokeErrorColor="@color/yarooms_error"
            app:errorTextColor="@color/yarooms_error"
            app:hintTextColor="@color/yarooms_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDuracaoAula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="Ex: 50"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/yarooms_gold_light" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutIntervaloAposAula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Intervalo após qual aula?"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/yarooms_gold"
            app:boxStrokeErrorColor="@color/yarooms_error"
            app:errorTextColor="@color/yarooms_error"
            app:hintTextColor="@color/yarooms_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editIntervaloAposAula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="Ex: 3"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/yarooms_gold_light" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDuracaoIntervalo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Duração do intervalo em minutos"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/yarooms_gold"
            app:boxStrokeErrorColor="@color/yarooms_error"
            app:errorTextColor="@color/yarooms_error"
            app:hintTextColor="@color/yarooms_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDuracaoIntervalo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="Ex: 20"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/yarooms_gold_light" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/botaoGerarPeriodosAula"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Gerar períodos automaticamente"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/yarooms_blue_dark"
            android:backgroundTint="@color/yarooms_gold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/textoErroPeriodosAula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yarooms_error"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Horários cadastrados"
            android:textColor="@color/yarooms_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/botaoFiltroManha"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Manhã"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold" />

            <Button
                android:id="@+id/botaoFiltroTarde"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Tarde"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold_light"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/botaoFiltroNoite"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Noite"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/yarooms_blue_dark"
                android:backgroundTint="@color/yarooms_gold_light"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <ListView
            android:id="@+id/listaPeriodosAula"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:background="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:padding="4dp"
            android:clipToPadding="false"
            android:scrollbarStyle="insideInset"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>