<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_yarooms_gradient">
    <Button android:id="@+id/voltarChat" android:layout_width="wrap_content" android:layout_height="48dp"
        android:text="@string/assistente_voltar" android:textAllCaps="false" android:textColor="@color/yarooms_gold_light" style="@style/Widget.MaterialComponents.Button.TextButton"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistente_titulo"
        android:textSize="30sp" android:textStyle="bold" android:textColor="@color/white" />
    <ScrollView android:id="@+id/rolagemChat" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/mensagens" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
    <EditText android:id="@+id/perguntaChat" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:maxLines="4" android:maxLength="1500" android:inputType="textMultiLine|textCapSentences"
        android:textColor="@color/white" android:textColorHint="@color/gray_text" android:hint="@string/assistente_pergunta"/>
    <com.google.android.material.button.MaterialButton app:cornerRadius="8dp" android:id="@+id/enviarChat" android:layout_width="match_parent" android:layout_height="54dp"
        android:text="@string/assistente_enviar" android:textAllCaps="false" android:backgroundTint="@color/yarooms_gold" android:textColor="@color/yarooms_blue_dark"/>
</LinearLayout>
