<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_yarooms_gradient"
    android:padding="32dp">

    <ImageView
        android:id="@+id/logoSplash"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YaRooms"
        android:textColor="@color/yarooms_gold"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agendamento inteligente de espaços"
        android:textColor="@color/yarooms_gold_light"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

</LinearLayout>