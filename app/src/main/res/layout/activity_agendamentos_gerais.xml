<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_yarooms_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <include layout="@layout/include_botao_voltar_topo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agendamentos Gerais"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acompanhe todas as reservas feitas pelos professores."
            android:textColor="@color/yarooms_gold_light"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDataAgendamentosGerais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Data dos agendamentos"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/yarooms_gold"
            app:boxStrokeErrorColor="@color/yarooms_error"
            app:errorTextColor="@color/yarooms_error"
            app:hintTextColor="@color/yarooms_gold_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDataAgendamentosGerais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@color/white"
                android:textColorHint="@color/yarooms_gold_light" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textoErroAgendamentosGerais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF8080"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <ListView
            android:id="@+id/listaAgendamentosGerais"
            android:layout_width="match_parent"
            android:layout_height="440dp"
            android:background="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:padding="4dp"
            android:clipToPadding="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoAtualizarAgendamentosGerais"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Atualizar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/yarooms_blue_dark"
            android:backgroundTint="@color/yarooms_gold"
            app:cornerRadius="8dp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>