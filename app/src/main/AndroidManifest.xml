<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permite o app acessar internet/API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Agend">

        <!-- SplashScreen: agora é a primeira tela aberta ao iniciar o app -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Login: agora NÃO é mais a tela inicial direta -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity android:name=".CadastroActivity" />

        <!-- Telas do professor -->
        <activity android:name=".professor.HomeActivity" />
        <activity android:name=".professor.ReservarSalaActivity" />
        <activity android:name=".professor.MinhasReservasActivity" />

        <!-- Telas do diretor -->
        <activity android:name=".diretor.DiretorHomeActivity" />
        <activity android:name=".diretor.AgendamentosGeraisActivity" />
        <activity android:name=".diretor.CadastrarSalaActivity" />
        <activity android:name=".diretor.MinhasSalasActivity" />
        <activity android:name=".diretor.GerenciarOpcoesUsoActivity" />
        <activity android:name=".diretor.GerenciarPeriodosAulaActivity" />

        <!-- Telas de recuperação de senha -->
        <activity android:name=".senha.EsqueciSenhaActivity" />
        <activity android:name=".senha.ConfirmarCodigoActivity" />
        <activity android:name=".senha.NovaSenhaActivity" />

    </application>

</manifest>